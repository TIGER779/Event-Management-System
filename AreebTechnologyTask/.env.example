# Settings for docker-compose.yml.
# Copy this file to ".env" (which is never committed) and change the values:
#
#     cp .env.example .env
#
# SQL Server "sa" password: at least 8 characters with upper case, lower case, a digit and a symbol.
# Do not use ";" (it would break the connection string).
DB_PASSWORD=Change_Me_123!

# Secret key that signs login tokens: any random text, at least 32 characters.
# Generate one with:  openssl rand -base64 48
#    or (PowerShell):  [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_KEY=replace-this-with-a-long-random-secret-of-at-least-32-characters
