{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "AppName": "Areeb Technology Task",
    "ConnectionStrings": {
        "Default": "Server=(localdb)\\MSSQLLocalDB;Database=Event_Booking_System;Trusted_Connection=True;TrustServerCertificate=True"
    },

    "Jwt": {
        "Key": ""
    },

    // Booking confirmation emails. Default: send to Mailpit on localhost:1025
    // (start it with "docker compose up -d mail" and read the emails at http://localhost:8025).
    // Mode "PickupDirectory" saves .eml files instead; "Disabled" sends nothing.
    // For real sending (e.g. Gmail) put Host/Port/Security/Username/Password in user-secrets, never here.
    "Email": {
        "Mode": "Smtp",
        "FromAddress": "tickets@eventbooking.local",
        "FromName": "Event Booking",
        "PublicBaseUrl": "https://localhost:5025",
        "PickupDirectory": "App_Data/emails",
        "Smtp": {
            "Host": "localhost",
            "Port": 1025,
            "Security": "None",
            "Username": "",
            "Password": ""
        }
    }
}
