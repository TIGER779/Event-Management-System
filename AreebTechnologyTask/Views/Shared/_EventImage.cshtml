@model EventImageModel
@inject IWebHostEnvironment Env
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@{
    var src = Model.Event.DisplayImageUrl;

    // A local image such as /Images/food-expo.jpg can have smaller WebP copies next to it:
    //   cards:   food-expo-card-400.webp, food-expo-card-700.webp  (2:1 crops, the shape of the cards)
    //   details: food-expo-400.webp, food-expo-800.webp            (original shape)
    // When they exist, the browser picks the best one for the screen; otherwise (e.g. an image an
    // admin added later, or an external URL) the original is used.
    var (suffix, widths) = Model.Card ? ("-card", new[] { 400, 700 }) : ("", new[] { 400, 800 });
    var (imgWidth, imgHeight) = Model.Card ? (700, 350) : (800, 533);
    string? webpSrcSet = null;
    if (src.StartsWith("/Images/", StringComparison.OrdinalIgnoreCase) && !src.Contains('?'))
    {
        var folder = src.Substring(0, src.LastIndexOf('/'));
        var baseName = System.IO.Path.GetFileNameWithoutExtension(src);
        var candidates = new List<string>();
        foreach (var width in widths)
        {
            var path = $"{folder}/{baseName}{suffix}-{width}.webp";
            if (Env.WebRootFileProvider.GetFileInfo(path).Exists)
            {
                candidates.Add($"{FileVersions.AddFileVersionToPath(Context.Request.PathBase, path)} {width}w");
            }
        }
        if (candidates.Count > 0)
        {
            webpSrcSet = string.Join(", ", candidates);
        }
    }
}
<picture class="d-block">
    @if (webpSrcSet != null)
    {
        <source type="image/webp" srcset="@webpSrcSet" sizes="@Model.Sizes" />
    }
    <img src="@src" asp-append-version="true" alt="@Model.Event.Name"
         class="@Model.CssClass" style="@Model.Style"
         width="@imgWidth" height="@imgHeight" decoding="async"
         loading="@(Model.Lazy ? "lazy" : "eager")"
         fetchpriority="@(Model.HighPriority ? "high" : "auto")"
         onerror="this.onerror=null;this.parentElement.querySelector('source')?.remove();this.src='/Images/placeholder.svg';" />
</picture>
