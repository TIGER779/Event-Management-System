@model IEnumerable<Event>

@{
    ViewData["Title"] = "Home";
    var bookedEventIds = ViewBag.BookedEventIds as List<int> ?? new List<int>();
    var token = Context.Request.Cookies["JwtToken"];
    bool isLoggedIn = !string.IsNullOrEmpty(token);
    string userRole = null;
    
    if (isLoggedIn)
    {
        var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
        var jwtToken = handler.ReadToken(token) as System.IdentityModel.Tokens.Jwt.JwtSecurityToken;
        userRole = jwtToken?.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
    }
}

<h2>Upcoming Events</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @{ var cardIndex = 0; }
    @foreach (var evt in Model)
    {
        // The first image is the page's main (LCP) image, so it is fetched first.
        // The first 3 cards can be on screen at load (one row on desktop, two cards on phones),
        // so only the cards after them are lazy-loaded.
        var index = cardIndex++;
        <div class="col">
            @* The whole card is clickable through the title's "stretched-link".
               Buttons/links inside the card sit above it (position-relative + z-index),
               so no interactive element is nested inside another one. *@
                <div class="card h-100 shadow-sm">
                    <partial name="_EventImage" model="@(new EventImageModel(evt,
                        CssClass: "card-img-top",
                        Style: "height:200px; object-fit:cover;",
                        Sizes: "(min-width: 768px) 33vw, 100vw",
                        HighPriority: index == 0,
                        Lazy: index >= 3))" />
                    <div class="card-body">
                        <h3 class="card-title h5">
                            <a href="@Url.Action("Details", "Home", new { id = evt.Id })" class="stretched-link text-reset text-decoration-none">@evt.Name</a>
                        </h3>
                        <p class="card-text">
                            <strong>Date:</strong> @evt.Date.ToShortDateString()<br />
                            <strong>Venue:</strong> @evt.Venue<br />
                            <strong>Category:</strong> @evt.Category<br />
                            <strong>Price:</strong> $@evt.Price
                        </p>
                        @if (bookedEventIds.Contains(evt.Id))
                        {
                            <span class="btn btn-success w-100 disabled">Booked</span>
                        }
                        else if (isLoggedIn && userRole != "Admin")
                        {
                            <form method="post" action="@Url.Action("BookEvent", "Home")" class="book-form position-relative" style="z-index: 2;">
                                <input type="hidden" name="eventId" value="@evt.Id" />
                                <button type="submit" class="btn btn-primary w-100">Book Now</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"
                               class="btn btn-outline-secondary w-100 position-relative" style="z-index: 2;">Login to Book</a>
                        }
                    </div>
                </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.book-form').on('submit', function (e) {
                e.preventDefault();

                const form = $(this);
                const eventId = form.find('input[name="eventId"]').val();

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: { eventId: eventId },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (response) {
                        if (response.success) {
                            // Redirect to the Congratulations page
                            window.location.href = response.redirectUrl;
                        } else {
                            alert(response.message || "Error booking the event.");
                        }
                    },
                    error: function () {
                        alert("Error booking the event. Please try again.");
                    }
                });
            });
        });
    </script>
}

