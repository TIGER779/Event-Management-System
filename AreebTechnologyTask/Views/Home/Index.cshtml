@model IEnumerable<Event>

@{
    ViewData["Title"] = "Upcoming Events";
    ViewData["Description"] = "Browse upcoming events and book your ticket online: technology, music, food, sports, art and business events.";
    var bookedEventIds = ViewBag.BookedEventIds as List<int> ?? new List<int>();
    bool isLoggedIn = User.Identity?.IsAuthenticated == true;
    bool isAdmin = User.IsInRole(nameof(UserRole.Admin));
}

<h2>Upcoming Events</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @{ var cardIndex = 0; }
    @foreach (var evt in Model)
    {
        // The first image is the page's main (LCP) image on phones, so it is fetched first.
        // The first row (3 cards) loads immediately; later cards are lazy-loaded, so phones
        // (one card per row) don't download images that are below the screen.
        // "sizes" = the card's width, from Bootstrap's container sizes (3 columns from 768px, 1 column below),
        // so the browser downloads the smallest image that is still sharp.
        var index = cardIndex++;
        const string cardSizes = "(min-width: 1400px) 416px, (min-width: 1200px) 356px, (min-width: 992px) 296px, (min-width: 768px) 216px, (min-width: 576px) 516px, calc(100vw - 24px)";
        <div class="col">
            @* The whole card is clickable through the title's "stretched-link".
               Buttons/links inside the card sit above it (position-relative + z-index),
               so no interactive element is nested inside another one. *@
                <div class="card h-100 shadow-sm">
                    <partial name="_EventImage" model="@(new EventImageModel(evt,
                        CssClass: "card-img-top",
                        Style: "height:200px; object-fit:cover;",
                        Sizes: cardSizes,
                        HighPriority: index == 0,
                        Lazy: index >= 3,
                        Card: true))" />
                    <div class="card-body">
                        <h3 class="card-title h5">
                            <a href="@Url.Action("Details", "Home", new { id = evt.Id })" class="stretched-link text-reset text-decoration-none">@evt.Name</a>
                        </h3>
                        <p class="card-text">
                            <strong>Date:</strong> @evt.Date.ToShortDateString()<br />
                            <strong>Venue:</strong> @evt.Venue<br />
                            <strong>Category:</strong> @evt.Category<br />
                            <strong>Price:</strong> $@evt.Price
                        </p>
                        @if (bookedEventIds.Contains(evt.Id))
                        {
                            <span class="btn btn-success w-100 disabled">Booked</span>
                        }
                        else if (isAdmin)
                        {
                            <span class="btn btn-outline-secondary w-100 disabled">Admins can't book events</span>
                        }
                        else if (isLoggedIn)
                        {
                            @* asp-action makes the form include the anti-forgery token, which BookEvent requires. *@
                            <form asp-controller="Home" asp-action="BookEvent" method="post" class="book-form position-relative" style="z-index: 2;">
                                <input type="hidden" name="eventId" value="@evt.Id" />
                                <button type="submit" class="btn btn-primary w-100">Book Now</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"
                               class="btn btn-outline-secondary w-100 position-relative" style="z-index: 2;">Login to Book</a>
                        }
                    </div>
                </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.book-form').on('submit', function (e) {
                e.preventDefault();

                const form = $(this);

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    // serialize() sends eventId and the anti-forgery token (__RequestVerificationToken).
                    data: form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (response) {
                        if (response.success) {
                            // Redirect to the Congratulations page
                            window.location.href = response.redirectUrl;
                        } else {
                            alert(response.message || "Error booking the event.");
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 401) {
                            // The login expired: log in again and come back here.
                            window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(location.pathname);
                            return;
                        }
                        alert("Error booking the event. Please try again.");
                    }
                });
            });
        });
    </script>
}

